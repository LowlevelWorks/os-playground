# Copy to .env. Real environment variables win over this file. Every setting
# is optional; leave one empty to use its default.

# Where to listen. Loopback by default; ":8080" listens on every interface.
PLAYGROUND_ADDR=127.0.0.1:8080

# Where Prometheus scrapes /metrics. Keep it off the public network.
PLAYGROUND_METRICS_ADDR=127.0.0.1:9090

# Postgres connection URL (required). A Unix socket works as ?host=/socket/dir.
PLAYGROUND_DATABASE_URL=postgres://playground:playground@127.0.0.1:5433/playground
# Largest connection pool. Each create waiting for admission holds one connection.
PLAYGROUND_DB_MAX_CONNS=10
# How long a create waits for the admission lock before answering 503 (max 30s).
PLAYGROUND_ADMISSION_LOCK_WAIT=2s

# How long to keep DELETED session rows and audit events, in hours (Go has no
# days): 720h is 30 days, 2160h is 90. Use 8760h (12 months) for audit if you
# need security or compliance evidence. A client's own policy overrides these.
PLAYGROUND_SESSION_RETENTION=720h
PLAYGROUND_AUDIT_RETENTION=2160h
# Connects as a member of the playground_retention role, the only one allowed
# to delete audit events. Empty keeps audit events forever. Locally the
# superuser from docker compose can switch to that role, so the same URL works.
PLAYGROUND_RETENTION_DATABASE_URL=postgres://playground:playground@127.0.0.1:5433/playground

# The OS image to boot, relative to this directory.
PLAYGROUND_OS_IMAGE="../../../my-os/build/os.iso"
PLAYGROUND_QEMU_BIN=qemu-system-x86_64
# tcg, kvm or hvf; empty lets QEMU choose (tcg). kvm needs Linux with /dev/kvm.
PLAYGROUND_QEMU_ACCEL=
PLAYGROUND_VM_MEMORY_MB=128

# How many VMs may run at once.
PLAYGROUND_MAX_SESSIONS=10
# Live sessions one user may hold (until login: one browser), and a looser
# backstop for one network address across all its users.
PLAYGROUND_MAX_SESSIONS_PER_USER=1
PLAYGROUND_MAX_SESSIONS_PER_CLIENT=3
# How long a failed session stays readable so the page can say why. Its VM
# and quota are released at once. At most 24h.
PLAYGROUND_FAILED_VISIBLE_FOR=5m

# The web app's pages: full origins, comma-separated. Only they may call the API
# with the login cookie, open a terminal, or be returned to after sign-in; the
# first is where sign-in returns by default.
PLAYGROUND_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sign in with Google (any OpenID Connect provider works). Create an OAuth
# client of type "Web application" in the Google Cloud console and add
# PLAYGROUND_PUBLIC_URL + /api/v1/auth/callback as an authorised redirect URI.
# Leave the client ID empty to run without sign-in: nobody can start a machine.
PLAYGROUND_OIDC_ISSUER=https://accounts.google.com
PLAYGROUND_OIDC_CLIENT_ID=
# A secret: put it in .env (never committed) or the environment, not here.
PLAYGROUND_OIDC_CLIENT_SECRET=
# The API's origin as browsers reach it: https, except for localhost.
PLAYGROUND_PUBLIC_URL=http://localhost:8080
# How long a sign-in lasts (at most 720h).
PLAYGROUND_LOGIN_SESSION_TTL=168h

# Remove a VM after this long with no browser attached, and after this long in any case.
PLAYGROUND_IDLE_TIMEOUT=2m
PLAYGROUND_MAX_DURATION=1h

# Per-client request limits; 0 turns one off. RPS and BURST are 0 together or not at all.
PLAYGROUND_RATE_LIMIT_RPS=10
PLAYGROUND_RATE_LIMIT_BURST=40
PLAYGROUND_CREATE_LIMIT_PER_MINUTE=5

# Reverse proxies in front of the server that append to X-Forwarded-For. Leave 0
# unless the server is reachable only through them.
PLAYGROUND_TRUSTED_PROXY_HOPS=0
