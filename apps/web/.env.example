# Copy to .env.local. Next.js loads it automatically.

API_URL=http://127.0.0.1:8080/api

# Sign-in uses a cookie the API sets. In development open the page on the same
# host name as the API (http://localhost:3000 with the API on localhost:8080),
# not 127.0.0.1: a cookie for "localhost" is not sent to "127.0.0.1".
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
# NEXT_PUBLIC_API_WS_URL=ws://localhost:8080/api

# NEXT_PUBLIC_API_WS_URL=wss://play.example.com

# The byte the Enter key sends: "cr" is what terminals normally send. Use "lf"
# if the OS only understands \n.
# NEXT_PUBLIC_ENTER_KEY=cr
